# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bookstore
POSTGRES_USER=bookstore
POSTGRES_PASSWORD=changeme

# Redis / Valkey
REDIS_URL=redis://redis:6379

# Meilisearch
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=changeme-meili-key

# Keycloak
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=bookstore
KEYCLOAK_CLIENT_ID=bookstore-api
KEYCLOAK_JWKS_URI=http://keycloak:8080/realms/bookstore/protocol/openid-connect/certs

# AI Service (internal)
AI_SERVICE_URL=http://ai-service:8000

# Local LLM inference (SGLang OpenAI-compatible API)
# Default target model for Akamai RTX 4000 Ada: Qwen/Qwen3-8B
# Stable fallback model: Qwen/Qwen2.5-7B-Instruct
LLM_BASE_URL=http://sglang:30000/v1
LLM_API_KEY=bookstore-local-key
LLM_MODEL=Qwen/Qwen3-8B
LLM_MAX_TOKENS=768
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120

# Required by SGLang when downloading gated Hugging Face models.
# Qwen models are generally public, but keeping this available makes model swaps easier.
HF_TOKEN=

# RAG embedding model. Keep this aligned with books.embedding vector dimensions in scripts/init.sql.
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K_VECTOR=5
RAG_TOP_K_SEARCH=5
MAX_CONTEXT_BOOKS=8

# Legacy optional Claude settings. The default BookBot path uses SGLang/Qwen.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Akamai Object Storage (S3-compatible)
AKAMAI_OBJECT_STORAGE_ENDPOINT=https://us-east-1.linodeobjects.com
AKAMAI_OBJECT_STORAGE_BUCKET=bookstore-assets
AKAMAI_ACCESS_KEY=change-me
AKAMAI_SECRET_KEY=change-me

# Frontend (Vite build-time vars)
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=bookstore
VITE_KEYCLOAK_CLIENT_ID=bookstore-web
